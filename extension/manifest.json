{
  "manifest_version": 3,
  "name": "GO Classroom Companion",
  "version": "0.2.0",
  "description": "Zichtbare, door de leerling gestarte schermdeling voor het GO Schoolportaal.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://cozynxis.github.io/ProwiseGO/*"
  ],
  "action": {
    "default_title": "GO Classroom Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://cozynxis.github.io/ProwiseGO/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["share.html", "share.js", "styles.css"],
      "matches": ["https://cozynxis.github.io/*"]
    }
  ]
}